# Copy to .env.local and fill in.
# Vite only exposes VITE_* vars to the client.

# Full URL to the /process endpoint on the backend (Flask server in mr_viewer.py).
# Example: http://localhost:5000/process  or  https://<your-tunnel>.ngrok-free.dev/process
VITE_SERVER_URL=

# Google Apps Script webhook URL for feedback submissions (leave empty to disable).
VITE_GOOGLE_SHEETS_URL=
